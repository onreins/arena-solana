# Upload only what the app needs to build and run; everything else (keys in
# .env, the 457 MB of minute prices, research, tests) stays on this machine.
# The build step (`npm run build` in vercel.json) compiles contracts/ into
# build/, so the contracts and the compile script have to come along.
/*
!/api
!/app
!/arena
!/bridge
!/mandate
!/contracts
# RedStone price-feed contracts compile only where dev dependencies are
# installed (tests, CI); the app needs just the feed address, not their build.
/contracts/RedStone*.sol
!/scripts
!/build
!/deployments
!/package.json
!/package-lock.json
!/vercel.json
/scripts/*
!/scripts/artifact.js
!/scripts/compile.js
/build/*
!/build/Mandate.json
!/build/MandateFactory.json
/deployments/*
!/deployments/testnet.json
!/deployments/mandate-testnet.json
.env*
