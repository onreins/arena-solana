# Upload only what the app needs to build and run; everything else (keys in
# .env, the 457 MB of minute prices, research, tests) stays on this machine.
# The build step (`npm run build` in vercel.json) compiles contracts/ into
# build/, so the contracts and the compile script have to come along.
/*
!/api
!/app
!/arena
!/bridge
!/mandate
# The Solana chain reader, relay and follow codec (app/callbook-routes.js on ARENA_NETWORK=solana-devnet).
!/solana
/solana/test
# The Callbook API reads the ERC-8004 registry ABIs from here (app/verify/callbook-network.js).
!/evaluator
/evaluator/*
!/evaluator/abi.js
!/contracts
# RedStone price-feed contracts compile only where dev dependencies are
# installed (tests, CI); the app needs just the feed address, not their build.
/contracts/RedStone*.sol
!/scripts
!/build
!/deployments
!/package.json
!/package-lock.json
!/vercel.json
/scripts/*
!/scripts/artifact.js
!/scripts/compile.js
# The Solana site's build step (vercel.json).
!/scripts/solana-site.mjs
/build/*
!/build/Mandate.json
!/build/MandateFactory.json
/deployments/*
!/deployments/testnet.json
!/deployments/mandate-testnet.json
!/deployments/callbook-testnet.json
!/deployments/callbook-mainnet.json
!/deployments/callbook-testnet-books.json
!/deployments/callbook-mainnet-books.json
.env*
