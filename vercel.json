{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "app/public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{build/Mandate.json,build/Callbook.json,build/MandateFactory.json,deployments/testnet.json,deployments/mandate-testnet.json,deployments/callbook-testnet.json,app/data/prices.json,app/data/index-snapshot.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/arena/p/:address",
      "destination": "/arena-profile"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/callbook",
      "destination": "/arena",
      "permanent": true
    },
    {
      "source": "/callbook-guide",
      "destination": "/arena-guide",
      "permanent": true
    },
    {
      "source": "/callbook-book",
      "destination": "/arena-bot",
      "permanent": true
    },
    {
      "source": "/callbook-caller",
      "destination": "/arena-caller",
      "permanent": true
    },
    {
      "source": "/callbook/agents/:file",
      "destination": "/arena/agents/:file",
      "permanent": true
    }
  ]
}
